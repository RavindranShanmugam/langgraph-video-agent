{
  "name": "site-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Renders a website in Chromium and emits a self-contained static frontend package.",
  "scripts": {
    "browser": "playwright install chromium",
    "extract": "node extract.mjs",
    "serve": "npx --yes http-server site -p 8080 -c-1",
    "reels": "node add-reels.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "ffmpeg-static": "^5.3.0"
  }
}
