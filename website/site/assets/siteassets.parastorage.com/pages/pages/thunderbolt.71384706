h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymqajf":{"skin":"RectangleArea","containerProps":{"containerLayoutClassName":"comp-mbymqajf-container max-width-container","overlowWrapperClassName":"comp-mbymqajf-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"tagName":null,"containerRootClassName":"","className":"","background":{"containerId":"comp-mbymqajf","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"fillLayers":{"containerId":"comp-mbymqajf","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false,"useWixMediaCanvas":false},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"isBuilder":false,"a11y":{},"translations":{}},"comp-mbymqajf_relative":{"containerLayoutClassName":"comp-mbymqajf-container max-width-container","overlowWrapperClassName":"comp-mbymqajf-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymqajj2":{"containerProps":{"containerLayoutClassName":"comp-mbymqajj2-container","overlowWrapperClassName":"comp-mbymqajj2-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"containerRootClassName":"","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymqajj2_relative":{"containerLayoutClassName":"comp-mbymqajj2-container","overlowWrapperClassName":"comp-mbymqajj2-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymqajk9":{"html":"<p class=\"font_8 wixui-rich-text__text\">0&ndash;1 Designer, UX &amp; Human-AI Interaction Consultant, Entrepreneurial Researcher</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymqajl10":{"html":"<h6 class=\"font_6 wixui-rich-text__text\">Human-first. Design-led. Tech-enabled.</h6>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymqajm4":{"html":"<p class=\"font_8 wixui-rich-text__text\">Passionately crafting responsible solutions, from vision to reality for<span class=\"color_11 wixui-rich-text__text\">&nbsp;7+ years. I am fluent in Research based design</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymqajm17":{},"comp-mbymqajn12":{"containerProps":{"containerLayoutClassName":"comp-mbymqajn12-container","overlowWrapperClassName":"comp-mbymqajn12-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"containerRootClassName":"","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymqajn12_relative":{"containerLayoutClassName":"comp-mbymqajn12-container","overlowWrapperClassName":"comp-mbymqajn12-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymqajo9":{"html":"<p class=\"font_8 wixui-rich-text__text\">I believe impactful design quietly empowers, not shouts. My philosophy is to get the basics right, understand deeply, design meaningfully, and execute purposefully.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Entrepreneurship fuels my creativity, from ideation brainstorms to turning ambitious hackathon concepts into investor-backed ventures.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Driven by curiosity, I experiment, transforming concepts into rigorous research, prototyping rapidly, and validating solutions through user insights. Each design challenge is an opportunity to create clear, intuitive, and human interfaces.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Great design is experiential, empathetic, and thoughtful. My focus is purposeful simplicity&mdash;clarity over clutter, function over fluff, solutions over aesthetics.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Artistic expression, through painting, motion graphics, and video editing, enriches my design practice. My love for technology keeps me exploring, with Generative AI as my latest favorite playground.</p>\n\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mr10":{"skin":"RectangleArea","containerProps":{"containerLayoutClassName":"comp-mbymg0mr10-container max-width-container","overlowWrapperClassName":"comp-mbymg0mr10-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"tagName":null,"containerRootClassName":"","className":"","background":{"containerId":"comp-mbymg0mr10","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"fillLayers":{"containerId":"comp-mbymg0mr10","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false,"useWixMediaCanvas":false},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"isBuilder":false,"a11y":{},"translations":{}},"comp-mbymg0mr10_relative":{"containerLayoutClassName":"comp-mbymg0mr10-container max-width-container","overlowWrapperClassName":"comp-mbymg0mr10-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymg0ms12":{"containerProps":{"containerLayoutClassName":"comp-mbymg0ms12-container","overlowWrapperClassName":"comp-mbymg0ms12-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"containerRootClassName":"","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0ms12_relative":{"containerLayoutClassName":"comp-mbymg0ms12-container","overlowWrapperClassName":"comp-mbymg0ms12-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymg0mt7":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Well, People like working with me!</span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mu":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mu-container","overlowWrapperClassName":"comp-mbymg0mu-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"containerRootClassName":"","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mu_relative":{"containerLayoutClassName":"comp-mbymg0mu-container","overlowWrapperClassName":"comp-mbymg0mu-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":false,"deviceType":"Desktop","role":"group"},"comp-mbymg0mu8":{"itemsPerRow":3,"repeaterType":"slider","flatListProps":{"horizontal":true,"showsHorizontalScrollIndicator":false,"contentContainerStyle":{"direction":"ltr","justifyContent":"flex-start","gap":9,"paddingTop":0,"paddingRight":0,"paddingBottom":0,"paddingLeft":0}},"items":["item-mbzuqtpo","item-mbzuqt1b","item-mbzuqrl1","item1","item-j9ples3e","item-j9plerjk"],"responsiveC