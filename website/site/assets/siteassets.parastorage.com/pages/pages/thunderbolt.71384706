ontent changes on hover"}},"comp-mbymg0mv6__item1":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv6-container","overlowWrapperClassName":"comp-mbymg0mv6-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv6-container","role":"listitem","isRepeaterItem":true,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv6__item-j9ples3e":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv6-container","overlowWrapperClassName":"comp-mbymg0mv6-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv6-container","role":"listitem","isRepeaterItem":true,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv6__item-j9plerjk":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv6-container","overlowWrapperClassName":"comp-mbymg0mv6-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv6-container","role":"listitem","isRepeaterItem":true,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv6_relative":{"containerLayoutClassName":"comp-mbymg0mv6-container","overlowWrapperClassName":"comp-mbymg0mv6-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"comp-mbymg0mv14":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item-mbzuqtpo":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item-mbzuqt1b":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item-mbzuqrl1":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item1":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item-j9ples3e":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14__item-j9plerjk":{"containerProps":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"containerRootClassName":"comp-mbymg0mv14-container","role":"","isRepeaterItem":false,"translations":{"ariaLabel":"content changes on hover"}},"comp-mbymg0mv14_relative":{"containerLayoutClassName":"comp-mbymg0mv14-container","overlowWrapperClassName":"comp-mbymg0mv14-overflow-wrapper","hasScrollOverflow":false,"hasOverflow":false,"shouldOmitWrapperLayers":true,"deviceType":"Desktop","role":"group"},"comp-mbymg0mw6":{"html":"<p class=\"font_8 wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\">&quot;Working with Sriram was an absolute win</span>. He&rsquo;s the kind of partner who makes every project better, not just because of his sharp technical skills but because <span class=\"color_11 wixui-rich-text__text\">he genuinely cares about the user experience and brings great energy to the table</span>. Thoughtful, creative, and always game to collaborate, Sriram made our work smoother and more enjoyable every step of the way.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Nick&nbsp;Malchoff&quot;</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item-mbzuqtpo":{"html":"<p class=\"font_8 wixui-rich-text__text\"><span class=\"color_11 wixui-rich-text__text\">&quot;Working with Sriram was an absolute win</span>. He&rsquo;s the kind of partner who makes every project better, not just because of his sharp technical skills but because <span class=\"color_11 wixui-rich-text__text\">he genuinely cares about the user experience and brings great energy to the table</span>. Thoughtful, creative, and always game to collaborate, Sriram made our work smoother and more enjoyable every step of the way.</p>\n\n<p class=\"font_8 wixui-rich-text__text\">Nick&nbsp;Malchoff&quot;</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item-mbzuqt1b":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">&quot;I had the pleasure of working with Srirarm during his time as a graduate assistant for our CSTEP program at SUNY Oswego. During his time with the program, he worked on a variety of initiatives&nbsp;related to our social media and communications. <span class=\"color_11 wixui-rich-text__text\">He was instrumental in updating and producing high-quality content for our social media, helping us to communicate to stakeholders the work of our program and students</span>. He is professional, hardworking, and self-motivated. He would be an excellent asset to a variety of teams and organizations.&quot;</h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item-mbzuqrl1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">&quot;If you&#39;re looking for <span class=\"color_11 wixui-rich-text__text\">someone who can think like a designer and build like a technologist, Sriram is that rare talent</span>. I look forward to seeing where his skills take him next&quot;</h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">&quot;Sriram is extremely creative and his passion for UX design and wanting to make a difference is inspiring.</span> <span class=\"color_11 wixui-rich-text__text\">His is big picture thinker and has many innovative designs.&quot;</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item-j9ples3e":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">&quot;I have always found Sriram to be a passionate and an out of the box thinker. <span class=\"color_11 wixui-rich-text__text\">He has the ability to think far ahead, foresee obstacles/challenges which might hinder achieving the goal and provide creative solutions addressing those.</span> He is also very good at market research strategies and the ideas he comes up with, often <span class=\"color_11 wixui-rich-text__text\">helps address major social concerns.</span> I would strongly recommend Sriram for any role that gives him the ability to apply his &quot;out of the box&quot; thinking capabilities.&quot;</h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mw6__item-j9plerjk":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">&quot;I worked with Sriram for multiple academic projects in my University. <span class=\"color_11 wixui-rich-text__text\">He is so passionate about design and problem solving</span>. His strong communication skills along with creative design skills are a great asset to any company.&quot;</h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx":{},"comp-mbymg0mx__item-mbzuqtpo":{},"comp-mbymg0mx__item-mbzuqt1b":{},"comp-mbymg0mx__item-mbzuqrl1":{},"comp-mbymg0mx__item1":{},"comp-mbymg0mx__item-j9ples3e":{},"comp-mbymg0mx__item-j9plerjk":{},"comp-mbymg0mx10":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">Nick&nbsp;Malchoff<br class=\"wixui-rich-text__text\">\n<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">Director, Marketing and Communication, SUNY Oswego</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx10__item-mbzuqtpo":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">Nick&nbsp;Malchoff<br class=\"wixui-rich-text__text\">\n<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">Director, Marketing and Communication, SUNY Oswego</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx10__item-mbzuqt1b":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">Christina Seado Vasquez<br class=\"wixui-rich-text__text\">\n<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">Director, CSTEP, SUNY Oswego</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx10__item-mbzuqrl1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">Rose Throop<br class=\"wixui-rich-text__text\">\n<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span class=\"color_13 wixui-rich-text__text\">Director, Creative service, SUNY Oswego</span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx10__item1":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Iris Du</span><br class=\"wixui-rich-text__text\">\n<span class=\"color_13 wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Co Founder,&nbsp; Careerist</span></span></span></h2>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-mbymg0mx10__item-j9ples3e":{"html":"<h2 class=\"font_2 wixui-rich-text__text\">SriLakshmi Balakrishnan<br class=\"wixui-rich-text__text\">\n<span class=\"color_13 wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Epic Report Analyst, Mount Sina